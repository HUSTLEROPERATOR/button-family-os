# ---------------------------------------------------------------------------
# Configurazione runtime — mai versionata: contiene URL e chiavi di progetto.
# Il solo file tracciato è il template runtime-config.example.js.
# ---------------------------------------------------------------------------
runtime-config.js
runtime-config.local.js
*.local.js
!runtime-config.example.js

# Token e credenziali di test
test-tokens.local.js
*.local.json

# Variabili d'ambiente
.env
.env.*
!.env.example

# Output di test, fixture e artefatti di verifica
/screenshots/
/fixtures/
/test-output/
/test-results/
*.png
*.jpg
*.jpeg
*.webp
*.log

# Dipendenze e build
node_modules/
dist/
build/
.cache/

# Sistema operativo / editor
Thumbs.db
Desktop.ini
.DS_Store
.idea/
.vscode/
